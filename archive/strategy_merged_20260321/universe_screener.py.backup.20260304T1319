def get_active_sessions(utc_hour: int) -> list:
    """Returns list of session dicts that are currently open."""
    active = []
    for session in SESSION_WINDOWS:
        o = session['open_utc']
        c = session['close_utc']
        if o > c:  # crosses midnight (e.g. Sydney 21-6)
            if utc_hour >= o or utc_hour < c:
                active.append(session)
        else:
            if o <= utc_hour < c:
                active.append(session)
    return active


def get_session_pairs(utc_hour: int) -> list:
    """
    Returns deduplicated list of pairs for all currently open sessions.
    Only includes pairs that are also in CANDIDATE_PAIRS.
    Falls back to full CANDIDATE_PAIRS if no session matched (shouldn't happen).
    """
    seen = set()
    pairs = []
    for session in get_active_sessions(utc_hour):
        for p in session['pairs']:
            if p not in seen and p in CANDIDATE_PAIRS:
                seen.add(p)
                pairs.append(p)
    return pairs if pairs else CANDIDATE_PAIRS


